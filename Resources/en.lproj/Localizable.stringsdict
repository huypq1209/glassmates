<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Đã xếp %lld cửa sổ.</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>Arranged %#@windows@.</string>
        <key>windows</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>lld</string>
            <key>one</key><string>%lld window</string>
            <key>other</key><string>%lld windows</string>
        </dict>
    </dict>
    <key>Đã xếp %lld cửa sổ. Không xếp được: %@.</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>Arranged %#@windows@. Couldn't arrange: %@.</string>
        <key>windows</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>lld</string>
            <key>one</key><string>%lld window</string>
            <key>other</key><string>%lld windows</string>
        </dict>
    </dict>
    <key>Mở: %@ (%lld app)</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>Open: %@ (%#@apps@)</string>
        <key>apps</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>lld</string>
            <key>one</key><string>%lld app</string>
            <key>other</key><string>%lld apps</string>
        </dict>
    </dict>
</dict>
</plist>
